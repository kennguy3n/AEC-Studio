{
  "name": "aec-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AEC/architecture/interior design studio (Electron + Rust)",
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/desktop",
    "build": "npm run build --workspace=apps/desktop",
    "build:native": "cargo build --release -p aec_bridge --features napi",
    "test": "npm run test:ui && npm run test:rust",
    "test:ui": "npm run test --workspace=apps/desktop",
    "test:rust": "cargo test --all",
    "lint": "npm run lint --workspace=apps/desktop",
    "type-check": "npm run type-check --workspace=apps/desktop",
    "format": "prettier --write '**/*.{ts,tsx,json,css,md}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,css,md}'"
  },
  "devDependencies": {
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
